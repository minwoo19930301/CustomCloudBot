# CustomCloudBot: load through your deployment service or node --env-file.
# Administrator UI can save the bot name and API/Gateway settings after signup.
# Those settings use COMMUNITY_DATA_DIR/setup-vault.json + setup-vault.key.
# Keep both files when backing up or upgrading; never commit populated values.
COMMUNITY_HOST=127.0.0.1
COMMUNITY_PORT=8787
COMMUNITY_DATA_DIR=.community-data
# Set your HTTPS origin in production; local quickstart overrides this value.
COMMUNITY_ORIGIN=
# Optional initial public native-app release metadata; leave empty until a real release exists.
# Administrators can override this catalog in the app's bot settings.
# JSON array: [{"platform":"macos","arch":"arm64","version":"0.1.0","url":"https://downloads.example/app.zip","notarized":false}]
# This contains public download URLs only, never signing or access credentials.
COMMUNITY_DESKTOP_DOWNLOADS=
# Random, private initial invitation. Consumed by the first admin signup.
COMMUNITY_BOOTSTRAP_TOKEN=
COMMUNITY_DEMO=0
# Optional application request caps; 0 leaves these app caps disabled.
# Provider rate limits and billing still apply.
COMMUNITY_DAILY_TURNS=0
COMMUNITY_GLOBAL_DAILY_TURNS=0
# Dedicated service credentials. Leave empty to disable AI calls.
COMMUNITY_LLM_BASE_URL=
COMMUNITY_LLM_API_KEY=
COMMUNITY_LLM_MODEL=
# API keys for live model lists and rotation. Leave unused names unset.
# GROQ_API_KEY_2, OPENAI_API_KEY_3, and so on add another key for that provider.
# COMMUNITY_LLM_PROVIDERS is a JSON array of {"name","baseUrl","apiKey"}.
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_TOKEN=
NVIDIA_NIM_API_KEY=
COHERE_API_KEY=
COMMUNITY_LLM_PROVIDERS=
# Optional server-only vault. Start from integrations.example.json; do not commit it.
COMMUNITY_INTEGRATIONS_FILE=
# Optional operator context, injected into administrator personal chats and the
# explicitly enabled host owner's sessions below.
# Absolute path to a private file outside the public source; disabled by default.
COMMUNITY_AGENT_CONTEXT_FILE=
# Optional host administration. Disabled unless BOTH values are set, and the
# separate root service/socket mount is installed. Only list intended owner IDs.
# Every invocation also requires the actor's current admin role and room membership.
# See deploy/host-admin/README.md; never mount this socket in a desktop container.
COMMUNITY_HOST_ADMIN_SOCKET=
COMMUNITY_HOST_ADMIN_USER_IDS=
# Optional isolated OpenClaw gateway. Existing environment settings remain supported.
# Official CLI/subscription authentication is separate from these API keys.
COMMUNITY_OPENCLAW_BASE_URL=
COMMUNITY_OPENCLAW_TOKEN=
COMMUNITY_OPENCLAW_AGENT_ID=community
# Overall gateway/tool deadline, 1000..180000 ms. Use 180000 for host administration.
COMMUNITY_OPENCLAW_TIMEOUT_MS=60000
# Only allows the exact Docker service hostname 'openclaw' over private HTTP.
COMMUNITY_OPENCLAW_ALLOW_PRIVATE_HTTP=0
# Optional Web Push. Keep VAPID private key and subject server-only; leave all three empty to disable push.
COMMUNITY_PUSH_SUBJECT=
COMMUNITY_PUSH_PUBLIC_KEY=
COMMUNITY_PUSH_PRIVATE_KEY=
# Map endpoints only after provisioning your own computer. URLs stay server-side.
COMMUNITY_DESKTOP_MAP={}
COMMUNITY_SHARED_DESKTOP_ROOM=
COMMUNITY_DESKTOP_VIEWS=0
# Optional first admin room provisioned at registration, must be in the desktop map.
COMMUNITY_INITIAL_ROOM_ID=
COMMUNITY_MEDIA_MAX_BYTES=12582912
COMMUNITY_MEDIA_DAILY_BYTES=104857600
COMMUNITY_MEDIA_STORAGE_BYTES=1073741824

# Optional private mailbox bridge (HTTPS API compatible with list/read/send/reply).
# Leave blank in forks; keep the bearer token on the server only.
COMMUNITY_MAIL_URL=
COMMUNITY_MAIL_TOKEN=
# Optional email task channel. Off until an operator connects approved senders.
COMMUNITY_MAIL_AGENT_ENABLED=0
# JSON array of {"email":"owner@example.com","userId":"existing-app-user-id"}; leave empty in forks.
COMMUNITY_MAIL_AGENT_USERS=
