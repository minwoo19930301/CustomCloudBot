# Extend the already verified ARM64 Chrome desktop; no provider/image switch.
FROM community-desktop:local
USER root
RUN apt-get update && apt-get install --no-install-recommends -y pcmanfm python3-aiohttp python3-pyatspi at-spi2-core dbus \
    && rm -rf /var/lib/apt/lists/*
COPY browser-openbox.xml /etc/openclawbot/browser-openbox.xml
COPY terminal.desktop chrome.desktop files.desktop /usr/local/share/applications/
COPY --chmod=0755 entrypoint.sh /usr/local/bin/desktop-entrypoint
COPY --chmod=0755 workspace-bridge.py /usr/local/bin/workspace-bridge
USER desktop
EXPOSE 6083
