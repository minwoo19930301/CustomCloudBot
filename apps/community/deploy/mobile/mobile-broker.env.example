# Copy outside the repository and restrict to the service account (chmod 600).
# The app server and broker share a newly generated secret; never send it to browsers.
MOBILE_BROKER_TOKEN=
# Prefer the Unix socket when the app and broker share the same host. No TCP port
# is opened while this is set. Grant the app access through the service group.
MOBILE_LISTEN_SOCKET=/run/community-mobile/mobile.sock
# Used only when MOBILE_LISTEN_SOCKET is empty:
MOBILE_LISTEN_HOST=127.0.0.1
MOBILE_LISTEN_PORT=8091
MOBILE_DATA_DIR=/var/lib/customcloudbot-mobile

# Select a verified Android image matching this host's architecture and binder setup.
MOBILE_ANDROID_IMAGE=
MOBILE_ANDROID_ARGS_JSON=[]
MOBILE_DOCKER_DEVICES_JSON=[]
MOBILE_DOCKER_PRIVILEGED=false
# Optional pre-created dedicated bridge with operator-managed egress firewall.
# Blank preserves Docker's default network; existing containers are never moved.
MOBILE_DOCKER_NETWORK=
MOBILE_MEMORY_MB=3072
MOBILE_CPUS=2

# Persistent slots and concurrent running devices are separate limits.
MOBILE_MAX_SLOTS=10
MOBILE_MAX_RUNNING=2
MOBILE_IDLE_SECONDS=600
MOBILE_LEASE_SECONDS=120
MOBILE_BOOT_SECONDS=90
MOBILE_ADB_BASE_PORT=16555

# Optional comma-separated pre-existing container names count toward the running cap.
# They are never assigned, stopped, removed, or modified by this broker.
MOBILE_EXTERNAL_CONTAINERS=

# Optional trusted IME baked into the operator-approved image for Unicode input.
# Example component: com.android.adbkeyboard/.AdbIME
MOBILE_INPUT_IME=
