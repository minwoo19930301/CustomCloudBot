# Copy to .env.production, fill required values, and chmod 600.
# Compose must be invoked with --env-file .env.production.
# No domain, server, workspace, account or AI provider is selected for you.
COMMUNITY_HOST=0.0.0.0
COMMUNITY_PORT=8787
COMMUNITY_DATA_DIR=/data
COMMUNITY_ORIGIN=
# Optional exact HTTPS origin used for installed apps; leave blank to use the website origin.
COMMUNITY_APP_ORIGIN=
COMMUNITY_PUBLIC_HOST=
# Domain HTTPS is the default. For public IPv4 HTTPS choose ./Caddyfile.ip.
COMMUNITY_CADDY_FILE=./Caddyfile.domain
# Generate a fresh UUID; use an absolute, dedicated directory owned by 10001.
COMMUNITY_SHARED_DESKTOP_ROOM=
COMMUNITY_DESKTOP_HOME=
COMMUNITY_BOOTSTRAP_TOKEN=
COMMUNITY_DEMO=0
# Optional automation metadata; this never chooses a cloud account.
COMMUNITY_RELEASE=
# Provider calls remain disabled until explicitly configured.
COMMUNITY_LLM_BASE_URL=
COMMUNITY_LLM_API_KEY=
COMMUNITY_LLM_MODEL=
COMMUNITY_LLM_VISION_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_TOKEN=
OPENROUTER_API_KEY=
COHERE_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
NVIDIA_NIM_API_KEY=
COMMUNITY_LLM_PROVIDERS=
COMMUNITY_OPENCLAW_BASE_URL=
COMMUNITY_OPENCLAW_TOKEN=
COMMUNITY_OPENCLAW_AGENT_ID=
COMMUNITY_OPENCLAW_ALLOW_PRIVATE_HTTP=0
COMMUNITY_OPENCLAW_NODE_OPTIONS=
# Optional dynamic desktop broker; leave empty for the shared desktop.
COMMUNITY_PROVISIONER_SOCKET=
# Optional Web Push: leave all three empty to disable.
COMMUNITY_PUSH_SUBJECT=
COMMUNITY_PUSH_PUBLIC_KEY=
COMMUNITY_PUSH_PRIVATE_KEY=
# Optional integration vault and administrator context, mounted separately.
# Start the vault from ../integrations.example.json; credentials stay in that file.
COMMUNITY_INTEGRATIONS_FILE=
COMMUNITY_AGENT_CONTEXT_FILE=

# Optional Android pool on this same host. Leave blank until the host's Android
# runtime is verified. Mount /run/community-mobile into only the app backend.
MOBILE_BROKER_SOCKET=
MOBILE_BROKER_TOKEN=
